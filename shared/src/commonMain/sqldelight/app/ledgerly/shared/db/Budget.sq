-- A monthly limit per category. month is 'YYYY-MM'.
CREATE TABLE budget (
    category_id TEXT NOT NULL REFERENCES category(id),
    month TEXT NOT NULL,
    limit_minor INTEGER NOT NULL,
    currency TEXT NOT NULL,
    updated_at INTEGER NOT NULL,
    PRIMARY KEY (category_id, month)
);

selectForMonth:
SELECT * FROM budget WHERE month = ?;

-- The limit in force for each category in :month: the latest one set in or before it.
-- A budget carries over month to month until it is changed; a limit of 0 removes it.
selectEffective:
SELECT budget.*
FROM budget
JOIN (
    SELECT category_id AS latest_category, MAX(month) AS latest_month
    FROM budget
    WHERE month <= :month
    GROUP BY category_id
) ON budget.category_id = latest_category AND budget.month = latest_month
WHERE budget.limit_minor > 0;

upsert:
INSERT OR REPLACE INTO budget (category_id, month, limit_minor, currency, updated_at) VALUES (?, ?, ?, ?, ?);

delete:
DELETE FROM budget WHERE category_id = ? AND month = ?;

-- For changing the currency: every limit, rewritten one by one.
budgetAmounts:
SELECT category_id, month, limit_minor, currency FROM budget;

updateBudgetAmount:
UPDATE budget SET limit_minor = :limitMinor, currency = :currency, updated_at = :updatedAt
WHERE category_id = :categoryId AND month = :month;
